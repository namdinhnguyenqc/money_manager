# Backend environment variables. Copy to .env and fill in real values.

# --- Server ---
API_PORT=8787
NODE_ENV=development

# --- Supabase (required in production) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth / JWT ---
JWT_SECRET=dev-secret-ONLY-for-local-dev-do-not-use-in-prod
JWT_EXPIRY_SECONDS=900
REFRESH_TOKEN_EXPIRY_DAYS=30

# --- Google sign-in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=
GOOGLE_CLIENT_SECRET=

# --- Admin bootstrap ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-prod-please-change

# --- SePay auto-reconcile ---
# Global fallback secret/api-key (per-owner values in system_settings take priority).
SEPAY_WEBHOOK_SECRET=
SEPAY_API_KEY=
# Prefix used when generating invoice payment codes (e.g. TCINVAB12CD34).
SEPAY_PAYMENT_PREFIX=TCINV
# Fail-closed: reject webhooks with no configured secret/api-key.
# Defaults to true in production, false in development. Set explicitly to override.
SEPAY_REQUIRE_AUTH=

# --- Zalo ---
ZALO_APP_ID=
ZALO_APP_SECRET=
ZALO_REDIRECT_URI=

# --- URLs / CORS ---
WEB_ADMIN_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3011,http://localhost:8081,http://localhost:19006
