    "framer-motion": "^12.38.0",
    "google-auth-library": "^7.0.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.300.0",
    "next": "^15.5.16",
    "radix-ui": "^1.4.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.8.1",
    "shadcn": "^4.7.0",
