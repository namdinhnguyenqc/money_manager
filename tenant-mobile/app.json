{
  "expo": {
    "name": "TrọCare Tenant",
    "slug": "trocare-tenant-mobile",
    "version": "1.0.0",
    "privacyPolicyUrl": "https://money-manager-xdem.onrender.com/privacy",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "trocare-tenant",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trocare.tenant",
      "buildNumber": "1",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "TroCare cần quyền chọn ảnh để khách thuê gửi ảnh phản hồi hoặc tài liệu hỗ trợ.",
        "NSPhotoLibraryAddUsageDescription": "TroCare cần quyền lưu ảnh khi khách thuê chia sẻ hóa đơn hoặc biên nhận.",
        "NSCameraUsageDescription": "TroCare cần quyền sử dụng camera để chụp ảnh tài liệu, hóa đơn hoặc gửi ảnh phản hồi."
      }
    },
    "android": {
      "versionCode": 1,
      "usesCleartextTraffic": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0066FF"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.trocare.tenant"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7d9194d0-1c63-4956-8ffd-0d490a259c35"
      }
    },
    "owner": "namng2611"
  }
}
